{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.39.26.7824",
      "templateHash": "3709882250902697735"
    }
  },
  "parameters": {
    "playbookName": {
      "type": "string",
      "defaultValue": "Playbook-Name"
    },
    "resourceGroupLocation": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]"
    }
  },
  "variables": {
    "subscriptionID": "[subscription().subscriptionId]"
  },
  "resources": [
    {
      "type": "Microsoft.Logic/workflows",
      "apiVersion": "2019-05-01",
      "name": "[parameters('playbookName')]",
      "location": "[parameters('resourceGroupLocation')]",
      "identity": {
        "type": "SystemAssigned"
      },
      "properties": {
        "state": "Disabled",
        "parameters": {},
        "definition": {
          "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
          "contentVersion": "1.0.0.0",
          "parameters": {
            "$connections": {
              "defaultValue": {},
              "type": "Object"
            }
          },
          "triggers": {
            "Recurrence": {
              "type": "Recurrence",
              "recurrence": {
                "frequency": "Minute",
                "interval": 15
              }
            }
          },
          "actions": {
            "Condition": {
              "actions": {
                "Condition_2": {
                  "actions": {
                    "Generate_TAP_via_Microsoft_Graph": {
                      "type": "Http",
                      "inputs": {
                        "uri": "https://graph.microsoft.com/v1.0/users/@{triggerBody()?['Assignment']?['Target']?['ObjectId']}/authentication/temporaryAccessPassMethods",
                        "method": "POST",
                        "body": {
                          "lifetimeInMinutes": "@variables('TAPLifetime')",
                          "isUsableOnce": false
                        },
                        "authentication": {
                          "type": "ManagedServiceIdentity",
                          "audience": "@{variables('MicrosoftGraphAudience')}"
                        }
                      },
                      "runtimeConfiguration": {
                        "contentTransfer": {
                          "transferMode": "Chunked"
                        }
                      }
                    },
                    "Set_variable": {
                      "runAfter": {
                        "Parse_JSON": [
                          "Succeeded"
                        ]
                      },
                      "type": "SetVariable",
                      "inputs": {
                        "name": "EmailContent",
                        "value": "<p>Hello @{triggerBody()?['Assignment']?['Target']?['DisplayName']},\n</p>\n<p>\nYour manager has requested a Temporary Access Pass so that you can reset your authentication methods. This TAP is valid for the next hour:\n</p>\n<p>@{body('Parse_JSON')?['temporaryAccessPass']}</p>\n<p>\nIf you have any questions, please contact your manager @{triggerBody()?['Requestor']?['DisplayName']}.\n</p>\n<p>\nBest regards\n</p>"
                      }
                    },
                    "Send_Email_via_Microsoft_Graph": {
                      "runAfter": {
                        "Set_variable": [
                          "Succeeded"
                        ]
                      },
                      "type": "Http",
                      "inputs": {
                        "uri": "https://graph.microsoft.com/v1.0/users/@{variables('EmailSender')}/sendMail",
                        "method": "POST",
                        "headers": {
                          "content-type": "application/JSON"
                        },
                        "body": {
                          "message": {
                            "body": {
                              "content": "@{variables('EmailContent')}",
                              "contentType": "HTML"
                            },
                            "subject": "@{variables('EmailSubject')}",
                            "toRecipients": [
                              {
                                "emailAddress": {
                                  "address": "@{variables('EmailRecipient')}"
                                }
                              }
                            ]
                          },
                          "saveToSentItems": "false"
                        },
                        "authentication": {
                          "type": "ManagedServiceIdentity",
                          "audience": "@{variables('MicrosoftGraphAudience')}"
                        }
                      },
                      "runtimeConfiguration": {
                        "contentTransfer": {
                          "transferMode": "Chunked"
                        }
                      }
                    },
                    "Parse_JSON": {
                      "runAfter": {
                        "Generate_TAP_via_Microsoft_Graph": [
                          "Succeeded"
                        ]
                      },
                      "type": "ParseJson",
                      "inputs": {
                        "content": "@body('Generate_TAP_via_Microsoft_Graph')",
                        "schema": {
                          "type": "object",
                          "properties": {
                            "@@odata.context": {
                              "type": "string"
                            },
                            "id": {
                              "type": "string"
                            },
                            "isUsable": {
                              "type": "boolean"
                            },
                            "methodUsabilityReason": {
                              "type": "string"
                            },
                            "temporaryAccessPass": {
                              "type": "string"
                            },
                            "createdDateTime": {
                              "type": "string"
                            },
                            "startDateTime": {
                              "type": "string"
                            },
                            "lifetimeInMinutes": {
                              "type": "integer"
                            },
                            "isUsableOnce": {
                              "type": "boolean"
                            }
                          }
                        }
                      }
                    }
                  },
                  "else": {
                    "actions": {}
                  },
                  "expression": {
                    "and": [
                      {
                        "equals": [
                          "@triggerBody()?['Stage']",
                          "assignmentRequestApproved"
                        ]
                      }
                    ]
                  },
                  "type": "If"
                }
              },
              "runAfter": {
                "Variable_Initialisation_": [
                  "Succeeded"
                ]
              },
              "else": {
                "actions": {}
              },
              "expression": {
                "and": [
                  {
                    "equals": [
                      "@{triggerBody()?['AccessPackageCatalog']?['Id']}",
                      "AccessPackageCatalogId"
                    ]
                  }
                ]
              },
              "type": "If"
            },
            "Variable_Initialisation_": {
              "runAfter": {
                "Parse_JSON_Target": [
                  "Succeeded"
                ]
              },
              "type": "InitializeVariable",
              "inputs": {
                "variables": [
                  {
                    "name": "MicrosoftGraphAudience",
                    "type": "string",
                    "value": "https://graph.microsoft.com"
                  },
                  {
                    "name": "TAPLifetime",
                    "type": "integer",
                    "value": 60
                  },
                  {
                    "name": "EmailSender",
                    "type": "string",
                    "value": "emailsender@sender.com"
                  },
                  {
                    "name": "EmailContent",
                    "type": "string"
                  },
                  {
                    "name": "EmailSubject",
                    "type": "string",
                    "value": "TAP request by your manager"
                  },
                  {
                    "name": "EmailRecipient",
                    "type": "string",
                    "value": "@{body('Parse_JSON_Target')?['Email']}"
                  }
                ]
              }
            },
            "Parse_JSON_Target": {
              "runAfter": {},
              "type": "ParseJson",
              "inputs": {
                "content": "@triggerBody()?['Assignment']?['Target']",
                "schema": {
                  "type": "object",
                  "properties": {
                    "Tenant": {},
                    "ConnectedOrganizationId": {
                      "type": "string"
                    },
                    "ConnectedOrganization": {
                      "type": "object",
                      "properties": {
                        "Id": {
                          "type": "string"
                        },
                        "DisplayName": {},
                        "Description": {}
                      }
                    },
                    "Id": {
                      "type": "string"
                    },
                    "ObjectId": {
                      "type": "string"
                    },
                    "AltSecId": {},
                    "DisplayName": {
                      "type": "string"
                    },
                    "PrincipalName": {
                      "type": "string"
                    },
                    "Email": {
                      "type": "string"
                    },
                    "OnPremisesSecurityIdentifier": {},
                    "Type": {
                      "type": "string"
                    },
                    "SubjectType": {
                      "type": "string"
                    },
                    "SubjectLifecycle": {
                      "type": "string"
                    },
                    "CleanupScheduledDateTime": {},
                    "CreatedDateTime": {}
                  }
                }
              }
            }
          },
          "outputs": {}
        }
      }
    }
  ]
}